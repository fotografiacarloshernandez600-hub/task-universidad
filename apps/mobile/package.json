  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "typescript": "~5.8.3",
    "vite": "^6.0.0",
    "cordova": "^12.0.0",
    "cordova-android": "^14.0.0",
    "cordova-plugin-sqlite-storage": "^6.1.0",
    "cordova-plugin-network-information": "^3.0.0"
  },
  "cordova": {
    "platforms": [],
    "plugins": {
      "cordova-plugin-sqlite-storage": {},
      "cordova-plugin-network-information": {}
