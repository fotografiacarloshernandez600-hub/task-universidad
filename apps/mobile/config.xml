<?xml version="1.0" encoding="utf-8"?>
<widget id="mx.edu.taskuniversitario" version="0.1.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>Task-Universitario</name>
  <description>Gestor académico web y móvil con seguimiento de titulación.</description>
  <author>Proyecto académico</author>
  <content src="index.html"/>
  <access origin="*"/>
  <allow-intent href="http://*/*"/>
  <allow-intent href="https://*/*"/>
  <preference name="AndroidXEnabled" value="true"/>
  <preference name="SplashScreenDelay" value="0"/>
  <platform name="android">
    <preference name="android-minSdkVersion" value="24"/>
  </platform>
</widget>
